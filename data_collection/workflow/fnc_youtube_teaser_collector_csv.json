    {
      "parameters": {
        "jsCode": "const releaseDate = new Date($('1건씩 처리').item.json.발매일);\nconst items = $input.first().json.items || [];\nconst keyword = /teaser|티저/i;\nlet candidates = items.filter(v => keyword.test(v.snippet.title));\nif (candidates.length === 0) candidates = items;\nlet best = null;\nlet bestDiff = Infinity;\nfor (const v of candidates) {\n  const publishedAt = new Date(v.snippet.publishedAt);\n  const diff = Math.abs(releaseDate - publishedAt);\n  if (diff < bestDiff) { bestDiff = diff; best = v; }\n}\nif (!best) return [{ json: { found: false, videoId: null, videoTitle: null } }];\nreturn [{ json: { found: true, videoId: best.id.videoId, videoTitle: best.snippet.title, videoPublishedAt: best.snippet.publishedAt } }];"
      },
