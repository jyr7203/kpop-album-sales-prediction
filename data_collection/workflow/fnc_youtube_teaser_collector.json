    {
      "parameters": {
        "jsCode": "const releaseDate = new Date($('1건씩 처리').item.json.발매일);\nconst items = $input.first().json.items || [];\n\nconst keyword = /teaser|티저/i;\n\nlet candidates = items.filter(v => keyword.test(v.snippet.title));\nif (candidates.length === 0) candidates = items;\n\nlet best = null;\nlet bestDiff = Infinity;\nfor (const v of candidates) {\n  const publishedAt = new Date(v.snippet.publishedAt);\n  const diff = Math.abs(releaseDate - publishedAt);\n  if (diff < bestDiff) {\n    bestDiff = diff;\n    best = v;\n  }\n}\n\nif (!best) {\n  return [{ json: { found: false, videoId: null, videoTitle: null } }];\n}\n\nreturn [{\n  json: {\n    found: true,\n    videoId: best.id.videoId,\n    videoTitle: best.snippet.title,\n    videoPublishedAt: best.snippet.publishedAt\n  }\n}];"
      },
